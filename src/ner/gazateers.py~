def LOC_list_formation():
    list_LOC = []
    fileptr = open('./Ner/ned.list.LOC','r')
    for line in fileptr:
        x = line.split()
        list_LOC.append(x[1])
    #print list_LOC
    fileptr.close()
    return list_LOC
        
